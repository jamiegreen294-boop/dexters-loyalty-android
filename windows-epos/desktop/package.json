{
  "name": "dexters-epos",
  "version": "0.1.0-test",
  "private": true,
  "description": "Dexters Windows EPOS test desktop application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "uk.co.dextersspot.epos",
    "productName": "Dexters EPOS",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Dexters-EPOS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dexters EPOS"
    },
    "extraResources": [
      {
        "from": "../",
        "to": "hub",
        "filter": [
          "DextersHub.js",
          "LocalStore.js",
          "SyncEngine.js",
          "IntegrationGateway.js",
          "PhoneOrders.js",
          "DexterAI.js",
          "OperationsCentre.js",
          "AlcoholCompliance.js",
          "Barcode.js",
          "DeliveryLookup.js",
          "MarketplaceAdapters.js",
          "integrations.example.json",
          "preloaded-drinks.json",
          "preloaded-snacks.json",
          "preloaded-alcohol.json",
          "app/**",
          "dashboard/**",
          "config.example.json"
        ]
      }
    ]
  }
}